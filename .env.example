# ============================================================
# Investment Research Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# .env is gitignored and will never be committed.

# ---------- Engine API Keys ----------
NEWSAPI_KEY=

# ---------- Supabase / Auth ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Optional: only set this if you want to enforce the "aud" claim (Supabase
# access tokens normally carry aud=authenticated). Leave unset to skip.
SUPABASE_JWT_AUDIENCE=

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins, e.g.:
# ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
ALLOWED_ORIGINS=

# ---------- Existing engine invocation ----------
# Defaults already match the repo layout; override only if you run the
# backend from somewhere else.
JAVA_PATH=java
JAVA_PROJECT_PATH=
JAVA_CLASSPATH=java/bin;java/lib/*
PIPELINE_OUTPUT_DIR=
PIPELINE_TIMEOUT_SECONDS=60

# ---------- Ticker validation ----------
# Path to the NSE (and/or BSE) equity listing CSV used for ticker validation.
# Defaults to backend/fixtures/EQUITY_L.csv (a small sample for local dev
# only) — point this at the real EQUITY_L.csv for production.
TICKER_CSV_PATH=

# ---------- Task metadata TTL (Redis key expiry, seconds) ----------
TASK_TTL_SECONDS=3600
